ESPN_LEAGUE_ID=1829348794
ESPN_S2=paste_your_espn_s2_cookie_value_here
ESPN_SWID={paste-your-swid-cookie-value-here}

# Postgres connection string (Vercel Postgres / Neon) — holds managers, lines, bets
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# Optional: protects POST/GET /api/sync. Name it exactly CRON_SECRET so
# Vercel Cron authenticates automatically; manual calls can also pass
# ?secret=... or an X-Sync-Secret header with this same value.
CRON_SECRET=
